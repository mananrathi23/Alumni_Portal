# =============================================================================
# Alumni Portal — Root .env (used by Docker Compose)
# =============================================================================
# Copy this file to .env on the server before running docker compose.
# Docker Compose reads it for variable substitution in docker-compose.yml.
# NEVER commit the actual .env file to git.
# =============================================================================

# ── Redis ──────────────────────────────────────────────────────────────────────
# Strong password for the Redis container. Must be set.
REDIS_PASSWORD=change_me_to_a_strong_redis_password

# All other settings (MongoDB, JWT, SMTP, OAuth, Cloudinary, ...) go in backend/.env
# — see backend/.env.example. Compose passes that file straight to the API.
