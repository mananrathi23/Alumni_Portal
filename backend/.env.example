# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
FRONTEND_URL=http://localhost:5173

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/Alumni-Portal

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_EXPIRE=7d
COOKIE_EXPIRE=7

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_SERVICE=gmail
SMTP_PORT=465
SMTP_MAIL=your@gmail.com
SMTP_PASSWORD=your_app_password

# ─── Cloudinary (profile photo uploads) ──────────────────────────────────────
# Setup steps:
# 1. Go to https://cloudinary.com and sign up for a FREE account
# 2. After login, go to Dashboard → copy Cloud Name, API Key, API Secret
# 3. Paste them below
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Twilio (optional — for SMS OTP) ─────────────────────────────────────────
# TWILIO_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
