# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
FRONTEND_URL=http://localhost:5173

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/Alumni-Portal

# Connections per backend instance (total = this × number of instances)
MONGO_MAX_POOL=20
MONGO_MIN_POOL=2

# ─── Redis (optional, strongly recommended in production) ─────────────────────
# Enables shared caching, rate limits, Socket.io across instances and cron locks
# Local dev (npm run docker:redis): REDIS_PASSWORD + REDIS_URL=redis://:<password>@127.0.0.1:6380
# Docker Compose production: ignored — compose points the API at its own Redis service
REDIS_PASSWORD=change_me
REDIS_URL=redis://:change_me@127.0.0.1:6380
# REDIS_ENABLED=false

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_EXPIRE=7d
COOKIE_EXPIRE=7

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_SERVICE=gmail
SMTP_PORT=465
SMTP_MAIL=your@gmail.com
SMTP_PASSWORD=your_app_password

# ─── Cloudinary (profile photo uploads) ──────────────────────────────────────
# Setup steps:
# 1. Go to https://cloudinary.com and sign up for a FREE account
# 2. After login, go to Dashboard → copy Cloud Name, API Key, API Secret
# 3. Paste them below
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Twilio (optional — for SMS OTP) ─────────────────────────────────────────
# TWILIO_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ─── Google OAuth (for Continue with Google) ──────────────────────────────────
# Setup: https://console.cloud.google.com → APIs & Services → Credentials
# Create OAuth 2.0 Client ID → Web Application
# Authorised redirect URI: http://localhost:4000/api/v1/oauth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
BACKEND_URL=http://localhost:4000

# ─── LinkedIn OAuth (for Continue with LinkedIn) ──────────────────────────────
# Setup: https://www.linkedin.com/developers → Create App → Auth tab
# Authorised redirect URL: http://localhost:4000/api/v1/oauth/linkedin/callback
# Required scopes: openid, profile, email
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
# Optional: override the OAuth callback URLs (default: derived from BACKEND_URL)
# GOOGLE_REDIRECT_URI=https://api.your-domain.com/auth/google/callback
# LINKEDIN_REDIRECT_URI=https://api.your-domain.com/api/v1/oauth/linkedin/callback
# Separate Google client used for sign-in (if different from the Calendar one)
GOOGLE_CLIENT_ID_LOGIN=
GOOGLE_CLIENT_SECRET_LOGIN=

# ─── Email via Brevo HTTP API (optional; used instead of SMTP when set) ───────
# Free tier sends ~300 emails/day. Useful if your host blocks SMTP ports.
BREVO_API_KEY=
SMTP_FROM=

# ─── Gemini (support chatbot, optional) ───────────────────────────────────────
GEMINI_API_KEY=
